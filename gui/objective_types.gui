												#alpha = 0.15
											}

										}

										textbox = {
											
											text = "AMA_NATION_SELECTION_PATHS"
											default_format = "#I"
											maximumsize = { 380 100 }
											fontsize_min = 10
											autoresize = yes
											multiline = yes
											using = fontsize_medium

											margin_top = 5

											
										}
									}



                                }

                                ### Lotharingia
                                widget = {

                                    size = { 400 400 }
                                    background = {

                                        using = default_background
                                    }

                                    icon = {
                                    	position = { 10 10 }
                                    	size = { 120 80 }
                                       	texture = "gfx/interface/icons/objectives/LOT_flag.dds"

                                    }

                                    textbox = {
                                        position = { 130 -65 }
                                        using = header_font_fancy
                                        using = header_font_fancy_size
                                        text = "LOT"
                                        size = { 200 200 }
                                        fontsize_min = 14
                                    }

                                    flowcontainer = {
										position = { 10 100 }
										direction = vertical
										minimumsize = { 400 -1 }
										
										spacing = 10
										
										margin_left = 10
										
										textbox = {
                                        
											text = "LOT_NATION_SELECTION_LORE"
											default_format = "#variable"
											maximumsize = { 360 200 }
											fontsize_min = 10
											autoresize = yes
											multiline = yes
											using = fontsize_medium

											divider_decorative = {
												size = { 100% 1 }
												parentanchor = bottom
												#alpha = 0.15
											}

										}

										textbox = {
											
											text = "LOT_NATION_SELECTION_PATHS"
											default_format = "#I"
											maximumsize = { 380 100 }
											fontsize_min = 10
											autoresize = yes
											multiline = yes
											using = fontsize_medium

											margin_top = 5

											
										}
									}



                                }
							}
						}
						### Hispanoameriga
                        vbox = {
							visible = no
                            #visible = "[GetVariableSystem.HasValue( 'selected_continent', 'hispanoameriga' )]"
                            spacing = 20
                            ### Row 1
                            hbox = {
                                spacing = 10

                                ### Colombie
                                widget = {

