types objective_types
{
    type objective_selection_menu = widget {
        size = { 100% 100% }

        

        ### HEADER
        icon = {
            texture = "gfx/interface/new_game_panel/frame_start_menu_top.dds"
            size = { 450 56 }
            parentanchor = hcenter
            spriteType = Corneredtiled
            spriteborder = { 100 0 }
            texture_density = 2

            textbox = {
                using = header_font_fancy
                using = header_font_fancy_size
                align = center|nobaseline
                raw_text = "World in 1836"
                size = { 100% 100% }
                elide = right
                fontsize_min = 14
                margin = { 75 0 }
                margin_bottom = 5
            }
        }

        ### BACK BUTTON
        button_standard_back = {
            position = { 1% 94% }
            size = { 300 55 }
            name = "back_button"
            shortcut = "close_window"
            using = fontsize_large
            onclick = "[GameSetup.OnBack]"
            oversound = "event:/SFX/UI/Global/pointer_over"
            clicksound = "event:/SFX/UI/Global/close"
        }
		### COUNTRY SELECTION BUTTON
		button = {
			using = default_button_primary_big_action
			size = { 300 55 }
			position = { 83% 94% }
			onclick = "[GameSetup.OnStart]"
			using = fontsize_large
			raw_text = "Proceed to Nation Selection"
			oversound = "event:/SFX/UI/Global/pointer_over"
			using = start_game_button_sound
		}
		### Close selected_continent
		button = {
			visible = "[GetVariableSystem.Exists('selected_continent')]"
			size = { 300 55 }
			position = { 40% 94% }
			onclick = "[GetVariableSystem.Clear('selected_continent')]"
			using = default_button
			raw_text = "Close Country Leaflet"
			oversound = "event:/SFX/UI/Global/pointer_over"
			clicksound = "event:/SFX/UI/Global/close"
		}
        ### BOTTOM BAR
        hbox = {
            position = { 25% 92% }
            name = "bottom_panel_not_selected"
            layoutpolicy_horizontal = expanding
            margin = { 15 0 }
            using = default_fade_in_out
            widget = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
            }
            game_rules_hbox = {}
            widget = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
            }

            start_game_buttons = {}
        }
		
        ### Map
			widget = {
				size = { 90% 88% }
				position = { 5% 2% }
				background = {
					texture = "gfx/interface/backgrounds/popup_bg_frame_frontend.dds"
					spriteType = Corneredstretched
					spriteborder = { 80 80 }
					texture_density = 2
					margin = { 28 10 }
					margin_top = -50
				}
				icon = {
					texture = "gfx/interface/icons/objectives/worldmapgui/world_map.dds"
					size = { 111% 113.5% }
					position = {-97 -21 }
				}
				
				### EUROPE
				icon = { #West Europa glow
					size = { 111% 113.5% }
					position = { -97 -21 }
					texture = "gfx/interface/icons/objectives/worldmapgui/west_europe.dds"
					
					visible = "[GetVariableSystem.HasValue('hover_continent', 'west_europe')]"
				}
				textbox = {
					visible = "[GetVariableSystem.HasValue('hover_continent', 'west_europe')]"
					position = { 33% 36% }
					using = header_font_fancy
					using = header_font_fancy_size
					raw_text = "West Europe"
					autoresize = yes
					fontsize_min = 14
						background = {
							using = default_header_bg_faded
							margin = { -5 0 }
						}
				}
				button = { #zoom button
					size = { 06% 16% }
					position = { 42.5% 30% }
					onmouseenter = "[GetVariableSystem.Set('hover_continent', 'west_europe')]"
					onmouseleave = "[GetVariableSystem.Clear('hover_continent')]"
